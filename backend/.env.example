# ─── Base de datos PostgreSQL ────────────────────────────────────
# Opción A: Supabase (recomendado para producción)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# Opción B: Local
DATABASE_URL=postgresql://postgres:password@localhost:5432/cinemax

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria_segura_2024

# ─── Administrador inicial ────────────────────────────────────────
ADMIN_EMAIL=admin@cinemax.com
ADMIN_PASSWORD=Admin2024!

# ─── Correo SMTP (Gmail) ──────────────────────────────────────────
# Para usar Gmail: activa "Contraseñas de aplicación" en tu cuenta Google
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# ─── Servidor ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
